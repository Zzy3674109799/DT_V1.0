page { background: #f5f7f2; color: #17231f; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.page { padding: 32rpx; }
.hero { background: #143e31; color: #fff; padding: 36rpx; border-radius: 24rpx; margin-bottom: 24rpx; }
.hero-title { display: block; font-size: 44rpx; font-weight: 800; }
.hero-copy { display: block; color: #c8ec4d; margin-top: 12rpx; font-size: 25rpx; }
.card { background: #fff; border-radius: 22rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 12rpx 40rpx rgba(30, 59, 45, .07); }
.card-title { display: block; font-size: 32rpx; font-weight: 700; margin-bottom: 20rpx; }
.map { width: 100%; height: 560rpx; border-radius: 18rpx; overflow: hidden; }
.stats { display: flex; justify-content: space-between; }
.stat-value { display: block; color: #286c4d; font-size: 38rpx; font-weight: 800; }
.stat-label { display: block; color: #77827c; font-size: 22rpx; margin-top: 6rpx; }
.place-row { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 0; border-bottom: 1rpx solid #edf1ed; }
.place-row:last-child { border-bottom: 0; }
.place-name { font-size: 28rpx; }
.place-status { color: #286c4d; font-size: 22rpx; }
.primary { background: #143e31; color: #fff; border-radius: 12rpx; margin-top: 24rpx; }
