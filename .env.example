PORT=8080
POSTGRES_PASSWORD=replace-with-db-password
DATABASE_URL=postgres://xingji:replace-with-db-password@db:5432/xingji
AUTH_MODE=demo
AUTH_SECRET=replace-with-a-long-random-secret
PAYMENT_MODE=mock
STORAGE_MODE=local
STORAGE_ROOT=/app/storage
REDIS_URL=redis://redis:6379

# 腾讯位置服务（服务端使用，不能提交真实 Key）
MAP_PROVIDER=tencent
TENCENT_MAP_KEY=replace-with-server-key

